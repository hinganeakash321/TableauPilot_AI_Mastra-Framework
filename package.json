    "@mastra/libsql": "1.20.0",
    "@mastra/loggers": "1.2.0",
    "@mastra/memory": "1.26.2",
    "@mastra/observability": "^1.17.0",
    "ai": "5.0.237",
    "fast-xml-parser": "^5.0.0",
    "jszip": "^3.10.1",
    "undici": "^7.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@mastra/evals": "1.7.0",
