{
  "name": "tableaupilot-ai",
  "version": "1.0.0",
  "description": "TableauPilot AI - Your Agentic AI Copilot for Tableau. Built with Mastra AI.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "studio": "mastra dev",
