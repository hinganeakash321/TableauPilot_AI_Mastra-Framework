# =============================================================
# TableauPilot AI - Environment Configuration (names only)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# The `.env` file is the single source of truth for secrets.
# =============================================================

# --- LLM provider selection ---
# Which provider the model layer resolves. "anthropic" (via gateway) or "openrouter".
LLM_PROVIDER=anthropic

# Model id used for the TableauPilot agent (Anthropic model name).
LLM_MODEL=claude-opus-4-8

# --- Anthropic Gateway (Anthropic-compatible endpoint) ---
# Base URL of the Anthropic-compatible gateway. Do NOT include a trailing /v1.
ANTHROPIC_BASE_URL=https://your-anthropic-gateway.example.com

# ONE of the following auth mechanisms is required for the anthropic provider:
#   1. Static key:
# ANTHROPIC_API_KEY=sk-ant-...
#   2. Key helper command (printed token is captured at runtime, never logged):
ANTHROPIC_API_KEY_HELPER=/path/to/auth-helper command args

# Optional corporate/self-signed CA bundle used when calling the gateway.
ANTHROPIC_CA_CERT=/path/to/corporate-ca-bundle.pem

# --- OpenRouter (fallback provider) ---
OPENROUTER_API_KEY=sk-or-v1-...
# Optional override; defaults to https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Tableau ---
# Target Tableau version stamped/validated by the engine (e.g. 2026.1).
TABLEAU_VERSION=2026.1

# --- App ---
# Root for original/working/output workbook artifacts.
WORKSPACE_PATH=./workspace
# Inbox where uploaded .twbx files are saved (via the /upload page or POST /upload).
UPLOADS_PATH=./uploads
# Port for the Node.js web UI (npm run ui). Defaults to 5173.
WEB_PORT=5173
# Logging verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# --- Reading extract (.hyper) data ---
# Path to the `hyperd` server binary used to read underlying extract data
# (inspectData / profileField / queryData). OPTIONAL: if unset, the app auto-detects
# an installed Tableau Desktop/Prep (e.g. "/Applications/Tableau Desktop <ver>.app/
# Contents/MacOS/hyper/hyperd") or a tableauhyperapi install. Set this only to
# override the auto-detected location.
# HYPERD_PATH=/Applications/Tableau Desktop (Apple silicon) 2026.1.app/Contents/MacOS/hyper/hyperd

# --- Tableau Cloud deployment (Phase 3) ---
# Credentials are entered at deploy time and never stored. These are optional
# defaults for local testing ONLY and should be left blank in shared configs.
# TABLEAU_CLOUD_URL=https://10ax.online.tableau.com
# TABLEAU_SITE_CONTENT_URL=your-site
# TABLEAU_PAT_NAME=
# TABLEAU_PAT_SECRET=
